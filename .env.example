# Copy this file to .env and fill in your own values.
# Supabase Dashboard → Project Settings → API Keys (and Data API for the URL).
PORT=3000
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key: sent to the browser so users can sign in. Safe to share.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Secret key: server only. Never commit it or put it in a page in /public.
SUPABASE_SECRET_KEY=sb_secret_your-key

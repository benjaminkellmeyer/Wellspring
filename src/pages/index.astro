---
// Event requests dashboard (built to /index.html).
// Clients see their own requests; staff see all requests and can update status, priority,
// coordinator and room, and archive. The SERVER enforces this; data-role only hides controls.
// The script below is the team's existing dashboard logic, restyled with the design system.
import StaffLayout from '../layouts/StaffLayout.astro';
---
<StaffLayout title="Event requests">
  <h1>Event requests</h1>
  <p class="muted" id="roleBanner">Checking sign-in…</p>

  <!-- One-time confirmation after submitting a request (set by eventForm) -->
  <div id="flash" role="status" aria-live="polite" hidden></div>
  <!-- Page messages: archive results, permission notes -->
  <div id="roleMsg" role="status" aria-live="polite" hidden></div>

  <!-- Hidden until sign-in finishes -->
  <div id="app" hidden>
    <div class="button-row page-actions">
      <!-- data-role="client": event requests are submitted by clients -->
      <button id="bCreate" type="button" class="btn btn-primary" data-role="client" onclick="window.location.href='eventForm.html';">Create</button>
      <button id="bRead" type="button" class="btn btn-secondary" aria-pressed="false">Read</button>
      <!-- data-role="coordinator": only staff can update (the server also rejects others with 403) -->
      <button id="bUpdate" type="button" class="btn btn-secondary" data-role="coordinator" aria-pressed="false">Update</button>
    </div>

    <!-- Update panel (staff) -->
    <section class="panel edit" id="edit" hidden aria-labelledby="editTitle">
      <h2 id="editTitle">Update a request</h2>
      <p class="small muted">Staff can change status, priority, coordinator, and room. Other details are read-only.</p>
      <div class="dash-grid">
        <div class="field wide"><label for="eid">Request to update</label><select id="eid"></select></div>
        <div class="field"><label for="f_st">Status</label><select id="f_st"></select></div>
        <div class="field"><label for="f_pri">Priority</label><select id="f_pri"></select></div>
        <div class="field"><label for="f_co">Coordinator</label><select id="f_co"></select></div>
        <div class="field"><label for="f_r">Room</label><select id="f_r"></select></div>
        <div class="field"><label for="f_name">Name</label><input id="f_name" maxlength="200" disabled /></div>
        <div class="field"><label for="f_cat">Category</label><select id="f_cat" disabled></select></div>
        <div class="field"><label for="f_type">Type</label><input id="f_type" disabled /></div>
        <div class="field"><label for="f_c">Client</label><select id="f_c" disabled></select></div>
        <div class="field"><label for="f_s">Start</label><input id="f_s" type="datetime-local" disabled /></div>
        <div class="field"><label for="f_e">End</label><input id="f_e" type="datetime-local" disabled /></div>
        <div class="field"><label for="f_att">Attendance</label><input id="f_att" type="number" min="2" max="350" disabled /></div>
        <div class="field"><label for="f_fur">Furniture</label><input id="f_fur" disabled /></div>
        <div class="field"><label for="f_tech">Technology</label><input id="f_tech" disabled /></div>
        <div class="field"><label for="f_cater">Catering</label><input id="f_cater" maxlength="200" disabled /></div>
        <div class="field wide"><label for="f_notes">Notes</label><textarea id="f_notes" rows="3" maxlength="2000" disabled></textarea></div>
      </div>
      <div class="button-row">
        <button id="bSave" type="button" class="btn btn-primary">Save changes</button>
        <button id="bCancel" type="button" class="btn btn-secondary">Cancel</button>
        <span id="msg" role="status" aria-live="polite"></span>
      </div>
    </section>

    <!-- Filters: hidden until Read; the filter fields open with Show filters -->
    <div class="filters" hidden>
      <div class="button-row">
        <button id="showFil" type="button" class="btn btn-secondary btn-sm" aria-pressed="false" aria-controls="fgrid">Show filters</button>
        <button id="reset" type="button" class="btn btn-secondary btn-sm">Reset filters</button>
      </div>
      <div class="toolbar fgrid" id="fgrid" hidden>
        <!-- data-role="coordinator": clients don't get a list of other clients' names -->
        <div class="field" data-role="coordinator"><label for="fc">Client</label><select id="fc"></select></div>
        <div class="field"><label for="co">Coordinator</label><select id="co"></select></div>
        <div class="field"><label for="type">Type</label><select id="type"></select></div>
        <div class="field"><label for="cat">Category</label><select id="cat"></select></div>
        <div class="field"><label for="room">Room</label><select id="room"></select></div>
        <div class="field"><label for="amin">Min attendance</label><input id="amin" type="number" min="2" max="350" /></div>
        <div class="field"><label for="d1">Starts on/after</label><input id="d1" type="date" /></div>
        <div class="field"><label for="d2">Starts on/before</label><input id="d2" type="date" /></div>
        <div class="field"><label for="pri">Priority</label><select id="pri"></select></div>
        <div class="field"><label for="st">Status</label><select id="st"></select></div>
        <div class="field"><label for="sort">Sort by</label><select id="sort"></select></div>
        <label class="check"><input id="arc" type="checkbox" /> Show archived</label>
      </div>
    </div>

    <!-- ADDED: quick lookup and quick filters. They narrow the requests already loaded (no database call). -->
    <div class="quickbar">
      <div class="search-bar">
        <label for="q" class="visually-hidden">Search requests</label>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input id="q" type="search" placeholder="Search by event, client, room or ID" autocomplete="off" aria-describedby="qHint" />
        <kbd id="qHint" title="Press / to search">/</kbd>
      </div>
      <div class="qf-row">
        <span class="qf-label" id="qfPriLabel">Priority</span>
        <div class="qf-chips" id="qfPri" role="group" aria-labelledby="qfPriLabel"></div>
      </div>
      <div class="qf-row">
        <span class="qf-label" id="qfStLabel">Status</span>
        <div class="qf-chips" id="qfSt" role="group" aria-labelledby="qfStLabel"></div>
      </div>
      <button type="button" class="qf-clear" id="qfClear" hidden>Clear quick filters</button>
    </div>

    <div class="table-head">
      <div>
        <p class="sort-note" id="sortNote" aria-live="polite"></p>
        <p class="small muted"><span id="count"></span> · <span id="viewHint"></span></p>
      </div>
      <div class="button-row view-toggle" role="group" aria-label="View">
        <button id="vTable" type="button" class="btn btn-secondary btn-sm" aria-pressed="true">Table</button>
        <button id="vCards" type="button" class="btn btn-secondary btn-sm" aria-pressed="false">Cards</button>
        <button id="colReset" type="button" class="btn btn-secondary btn-sm" title="Restore the default column order and widths">Reset columns</button>
      </div>
    </div>
    <p id="dbmsg" class="muted" role="status"></p>
    <div class="data-table" id="tblwrap">
      <table>
        <thead id="thead"></thead>
        <tbody id="tbody"></tbody>
      </table>
    </div>
    <!-- Card view: same rows, filters and sort as the table -->
    <div class="card-grid" id="cards" hidden></div>
  </div>
</StaffLayout>

<!-- is:global because the table rows are created by the script, so Astro's scoped styles can't reach them.
     Every rule is limited to this page's #app, #flash or #roleMsg. -->
<style is:global>
  /* Fluid width on this page: up to 85% of the window, never narrower than the standard 1040px.
     The header uses .staff-wrap too, so it stays aligned with the content. */
  body.staff .staff-wrap { max-width: max(1040px, 85vw); }
  #roleBanner { margin-bottom: 24px; }
  #app .page-actions { margin-bottom: 24px; }
  #app .btn-secondary[aria-pressed="true"] { background: var(--teal-50); border-color: var(--teal-500); color: var(--teal-700); }
  #app .edit { margin-bottom: 24px; }
  #app .edit h2 { margin-bottom: 4px; }
  #app .dash-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(230px, 100%), 1fr)); gap: 0 16px; align-items: start; margin-top: 16px; }
  #app .dash-grid .wide { grid-column: 1 / -1; }
  /* Date-time inputs have a built-in minimum width that overflows narrow grid columns. */
  #app .dash-grid input, #app .fgrid input { min-width: 0; }
  #app .field input:disabled, #app .field select:disabled, #app .field textarea:disabled { background: var(--gray-50); color: var(--ink-2); }
  #msg { font-size: 14px; line-height: 20px; font-weight: 500; }
  #msg.msg-ok { color: var(--teal-700); font-weight: 600; }
  #msg.msg-err { color: var(--coral-700); }
  #msg.msg-info { color: var(--ink-3); }
  #app .filters { margin-bottom: 16px; }
  #app .filters .button-row + .fgrid { margin-top: 12px; }
  #app .fgrid .field { flex: 1 1 170px; }
  #app .check { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-size: 16px; cursor: pointer; }
  #app .check input { width: 18px; height: 18px; margin: 0; accent-color: var(--teal-600); }
  #app .check input:focus-visible { outline: none; box-shadow: 0 0 0 2px #fff, 0 0 0 4px var(--teal-500); }
  #app .table-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 16px; margin-bottom: 8px; }
  #app #dbmsg:empty { display: none; }
  #app .data-table table { min-width: 760px; }
  #app .data-table th { cursor: pointer; user-select: none; }
  #app .data-table th[data-k="act"] { cursor: default; }
  /* Sorted column: teal text and the same underline as the active nav link */
  #app .data-table th.on { color: var(--teal-700); box-shadow: inset 0 -2px 0 var(--teal-500); }
  #app .data-table th .ar { font-size: 10px; }
  /* Text cells wrap; badges, priority and the date line stay whole. */
  #app .data-table th, #app .data-table td { padding-left: 10px; padding-right: 10px; }
  #app .data-table tr.row td { vertical-align: middle; padding-top: 14px; padding-bottom: 14px; }
  /* Hierarchy: the event name leads; supporting columns step back */
  #app .data-table td[data-k="name"] { font-size: 17px; line-height: 24px; font-weight: 600; color: var(--ink); }
  #app .data-table td[data-k="c"], #app .data-table td[data-k="r"], #app .data-table td[data-k="co"], #app .data-table td[data-k="type"] { font-size: 15px; line-height: 22px; color: var(--ink-2); }
  #app .data-table tr.arch td[data-k="name"] { color: var(--ink-3); }
  /* Urgent: the whole priority cell is filled. --ink on --coral-500 = 6.08:1 (the spec's coral pairing). */
  #app .data-table tr.row td.prio-cell-urgent, #app .data-table tr.row:hover td.prio-cell-urgent, #app .data-table tr.row.sel td.prio-cell-urgent { background: var(--coral-500); }
  #app td.prio-cell-urgent .prio, #app .prio-pill-urgent .prio { color: var(--ink); font-weight: 700; }
  #app td.prio-cell-urgent .prio::before, #app .prio-pill-urgent .prio::before { background: var(--ink); }
  #app .prio-pill-urgent { display: inline-flex; padding: 2px 10px; border-radius: 9999px; background: var(--coral-500); }

  /* Column resize and drag-to-reorder */
  #app .data-table th { position: relative; overflow: hidden; text-overflow: ellipsis; }
  #app .data-table th:focus-visible { outline: none; box-shadow: inset 0 0 0 2px var(--teal-500); }
  #app .col-resize { position: absolute; top: 0; right: 0; width: 10px; height: 100%; cursor: col-resize; touch-action: none; }
  #app .col-resize::after { content: ""; position: absolute; top: 25%; right: 4px; width: 2px; height: 50%; border-radius: 2px; background: var(--line-2); }
  #app .col-resize:hover::after, #app .col-resize:focus-visible::after { background: var(--teal-500); }
  #app .col-resize:focus-visible { outline: none; box-shadow: inset 0 0 0 2px var(--teal-500); }
  #app th.dragging { opacity: 0.5; }
  #app th.drop-before { box-shadow: inset 3px 0 0 var(--teal-500); }
  #app th.drop-after { box-shadow: inset -3px 0 0 var(--teal-500); }
  #app .data-table td { overflow-wrap: break-word; } /* wrap between words; break a word only if it can't fit at all */
  body.col-resizing, body.col-resizing * { cursor: col-resize !important; user-select: none; }
  #app .data-table tr.row { cursor: pointer; }
  #app .data-table tr.row.sel td { background: var(--teal-50); }
  #app .data-table tr.arch td { color: var(--ink-3); }
  #app .data-table tr.det td { background: var(--gray-50); }
  #app .data-table tr.det:hover td { background: var(--gray-50); }
  /* sticky + max-width keep a row's details inside the visible part of the scrolling table */
  #app .dg { position: sticky; left: 12px; max-width: min(940px, calc(100vw - 80px)); display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px 24px; padding: 4px 0; }
  #app .dg small { display: block; font-size: 12px; line-height: 16px; font-weight: 600; color: var(--ink-3); }
  #app .empty { text-align: center; color: var(--ink-3); padding: 32px 16px; }
  #app .data-table td[data-k="s"], #app .data-table td[data-k="pri"] { white-space: nowrap; }
  #app .archived-on { display: block; margin-top: 4px; }

  /* Search bar and quick filters */
  #app .quickbar { margin: 8px 0 20px; }
  #app .search-bar { display: flex; align-items: center; gap: 10px; padding: 0 14px; margin-bottom: 14px; background: #fff; border: 1px solid var(--line-2); border-radius: 8px; color: var(--ink-3); }
  #app .search-bar:focus-within { border-color: var(--teal-500); box-shadow: 0 0 0 3px var(--teal-100); }
  #app .search-bar input { flex: 1; min-width: 0; height: 48px; border: 0; background: transparent; font: inherit; font-size: 17px; color: var(--ink); outline: none; }
  #app .search-bar kbd { font: inherit; font-size: 12px; line-height: 16px; padding: 2px 7px; border: 1px solid var(--line-2); border-radius: 4px; background: var(--gray-100); color: var(--ink-2); }
  #app .qf-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin-bottom: 8px; }
  #app .qf-label { min-width: 64px; font-size: 14px; line-height: 20px; font-weight: 600; color: var(--ink-2); }
  #app .qf-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  #app .qf { display: inline-flex; align-items: center; gap: 6px; min-height: 36px; padding: 0 12px; border: 1px solid var(--line-2); border-radius: 9999px; background: #fff; color: var(--ink-2); font: inherit; font-size: 14px; line-height: 20px; font-weight: 500; cursor: pointer; }
  #app .qf:hover { background: var(--gray-50); }
  #app .qf[aria-pressed="true"] { background: var(--teal-50); border-color: var(--teal-500); color: var(--teal-700); font-weight: 600; }
  #app .qf-n { min-width: 20px; padding: 0 6px; border-radius: 9999px; background: var(--gray-100); color: var(--ink-2); font-size: 12px; line-height: 18px; font-weight: 600; text-align: center; }
  #app .qf[aria-pressed="true"] .qf-n { background: #fff; color: var(--teal-700); }
  #app .qf-pri-urgent { border-color: var(--coral-500); }
  #app .qf-pri-urgent[aria-pressed="true"] { background: var(--coral-500); border-color: var(--coral-500); color: var(--ink); }
  #app .qf-pri-urgent[aria-pressed="true"] .qf-n { color: var(--ink); }
  #app .qf-clear { margin-top: 4px; padding: 4px 0; border: 0; border-radius: 4px; background: none; font: inherit; font-size: 14px; font-weight: 500; color: var(--teal-600); cursor: pointer; }
  #app .qf-clear:hover { color: var(--teal-700); text-decoration: underline; }

  /* Sort note and view switch */
  #app .table-head { align-items: flex-end; margin-bottom: 12px; }
  #app .table-head p { margin: 0; }
  #app .sort-note { font-size: 15px; line-height: 22px; font-weight: 600; color: var(--teal-700); }

  /* Priority: a colored dot plus the word, so it reads differently from the status badges.
     Existing colors only; urgent text uses --coral-700 (5.3:1 on white). */
  #app .prio { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; font-size: 14px; line-height: 20px; font-weight: 500; color: var(--ink-2); }
  #app .prio::before { content: ""; width: 10px; height: 10px; border-radius: 9999px; background: var(--line-2); flex: none; }
  #app .prio-urgent { color: var(--coral-700); font-weight: 600; }
  #app .prio-urgent::before { background: var(--coral-700); }
  #app .prio-high::before { background: var(--coral-500); }
  #app .prio-medium::before { background: var(--teal-500); }
  #app .prio-low::before { background: var(--line-2); }

  /* Card view */
  #app #cards { margin-bottom: 24px; align-items: start; } /* opening one card doesn't stretch its neighbors */
  #app #cards > .empty { grid-column: 1 / -1; }
  #app .ev-card { cursor: pointer; }
  #app .ev-card.sel { border-color: var(--teal-500); }
  #app .ev-card.arch .card-body { color: var(--ink-3); }
  #app .ev-card .card-body { display: flex; flex-direction: column; height: 100%; }
  #app .ev-card-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 12px; }
  #app .ev-card-title { margin-bottom: 12px; }
  #app .ev-meta { display: grid; grid-template-columns: max-content 1fr; gap: 4px 16px; margin: 0 0 16px; }
  #app .ev-meta > div { display: contents; }
  #app .ev-meta dt { font-size: 14px; line-height: 20px; font-weight: 600; color: var(--ink-3); }
  #app .ev-meta dd { margin: 0; }
  #app .ev-card-details { margin: 0 0 16px; padding: 12px; border-radius: 8px; background: var(--gray-50); cursor: default; }
  #app .ev-card-details .dg { position: static; max-width: none; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 12px 16px; }
  #app .ev-card-actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; margin-top: auto; }
  #app .card-toggle { background: none; border: 0; padding: 4px 0; border-radius: 4px; font: inherit; font-weight: 500; color: var(--teal-600); cursor: pointer; }
  #app .card-toggle:hover { color: var(--teal-700); text-decoration: underline; }
</style>

<!-- Dashboard logic (unchanged from the team's version except display: status badges, alerts, save messages) -->
<script is:inline>
var PR=['urgent','high','medium','low'],
ST=['submitted','in_progress','scheduled','declined','cancelled','needs_followup','completed'],
CAT=['public','private','tenant'];
/* CHANGED (Assignment 7): the page no longer talks to Supabase directly. It calls the Express server
   (see load() below), which checks the sign-in token and role before reading the database. */
var CL={},CO={},RM={},D=[];
function nm(m,id){return id==null?'—':(m[id]||String(id))}
/* ADDED (design system): our statuses mapped onto the shared .status-<value> badge styles (no new colors). */
var STATUS_CLASS={submitted:'pending',needs_followup:'needs_update',in_progress:'pending_review',scheduled:'approved',completed:'current',declined:'rejected',cancelled:'archived'};
function badge(s){return '<span class="status status-'+(STATUS_CLASS[s]||'archived')+'">'+lab(s)+'</span>'}
/* ADDED (design system): page messages as alerts. kind: 'error' | 'success' | 'info'. Empty text hides it. */
function note(text,kind){var m=document.getElementById('roleMsg');m.hidden=!text;m.className=text?'alert alert-'+(kind||'info'):'';m.textContent=text||''}
function setMsg(text,kind){var m=document.getElementById('msg');m.textContent=text;m.className=kind?'msg-'+kind:''}

    var $ = function (i) { return document.getElementById(i) };
    function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] }) }
    function fmt(s) { return s ? new Date(s).toLocaleString([], { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' }) : '—' }
    function lab(s) { return String(s).replace(/_/g, ' ') }
    /* ALTERED: uses scoped() instead of D so the Type filter list only contains values from
       requests the current user is allowed to see (otherwise a client would see other clients' values). */
    function uniq(k) { return scoped().map(function (x) { return x[k] }).filter(function (v, i, a) { return v != null && a.indexOf(v) === i }).sort(function (a, b) { return a > b ? 1 : -1 }) }
    function opts(el, all, arr) { el.innerHTML = (all ? '<option value="">' + all + '</option>' : '') + arr.map(function (v) { return '<option value="' + esc(v) + '">' + esc(lab(v)) + '</option>' }).join('') }
    // ADDED (Version B): builds a dropdown from an id -> name map. "all" adds a blank-value first option, "none" adds a "none" option last.
    function optsMap(el, all, map, none) {
      var h = all ? '<option value="">' + all + '</option>' : '';
      h += Object.keys(map).map(function (k) { return '<option value="' + k + '">' + esc(map[k]) + '</option>' }).join('');
      if (none) h += '<option value="none">' + none + '</option>';
      el.innerHTML = h;
    }
    /* ALTERED: Room and Coordinator filter lists now show names (Version B), and for client users only the rooms
       and coordinators that appear on their own requests (visibleMap, defined in the role section below). */
    function buildFilters() {
      var keep = { type: $('type').value, room: $('room').value, co: $('co').value };
      opts($('type'), 'All types', uniq('type'));
      optsMap($('room'), 'All rooms', visibleMap(RM, 'r'), 'No room assigned');
      optsMap($('co'), 'All coordinators', visibleMap(CO, 'co'));
      ['type', 'room', 'co'].forEach(function (k) { $(k).value = keep[k] });
    }
    opts($('cat'), 'All categories', CAT); opts($('st'), 'All statuses', ST); opts($('pri'), 'All priorities', PR); buildFilters();
    // ADDED (Version B): Client filter list and the three name dropdowns in the update form (all clients, coordinators and the 7 rooms)
    optsMap($('fc'), 'All clients', CL);
    optsMap($('f_c'), '', CL); optsMap($('f_co'), '', CO); optsMap($('f_r'), 'No room assigned', RM);
    opts($('f_cat'), '', CAT); opts($('f_pri'), '', PR); opts($('f_st'), '', ST);
    // ALTERED (Version B): 12 columns. End, Guests and Created moved into the expandable detail row; headers renamed; Archive column added; Sq ft removed.
    /* CHANGED (dashboard refresh): 9 columns. ID is in the details; Category shows under Type; the archived date shows under Archive. */
    var QF = { pri: [], st: [] }; // ADDED: active quick filters
    var COLS = [['name', 'Event'], ['st', 'Status'], ['c', 'Client'], ['s', 'Start'], ['r', 'Room'], ['type', 'Type'], ['pri', 'Priority'], ['co', 'Staff'], ['act', 'Archive']];
    var SORTS = [['s:asc', 'Start (soonest)'], ['s:desc', 'Start (latest)'], ['cr:desc', 'Created (newest)'], ['cr:asc', 'Created (oldest)'], ['pri:asc', 'Priority (highest first)'], ['st:asc', 'Status'], ['att:desc', 'Attendance (largest)'], ['name:asc', 'Name A–Z']];
    $('sort').innerHTML = SORTS.map(function (s) { return '<option value="' + s[0] + '">' + s[1] + '</option>' }).join('');
    // ALTERED (Version B): "recent" remembers rows archived since the filters last changed, so they don't vanish the moment you click Archive.
    var key = 's', dir = 1, selId = null, openRows = {}, recent = {};

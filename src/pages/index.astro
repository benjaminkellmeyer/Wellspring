    $('bUpdate').addEventListener('click', function () { showEdit($('edit').hidden) });
    $('bCancel').addEventListener('click', function () { showEdit(false) });
    $('eid').addEventListener('change', function () { selId = +$('eid').value; loadForm(selId); render() });
    // CHANGED (Assignment 7): Save sends only the changed fields to the server (PATCH /api/events/:id).
    // The server checks that the user is staff and validates every value before saving.
    $('bSave').addEventListener('click', async function () {
      var x = get(+$('eid').value); if (!x) return;
      var body = {};
      if ($('f_st').value !== x.st) body.status = $('f_st').value;
      if ($('f_pri').value !== x.pri) body.priority = $('f_pri').value;
      if ($('f_co').value !== String(x.co)) body.co_id = $('f_co').value;
      if ($('f_r').value !== (x.r == null ? '' : String(x.r))) body.r_id = $('f_r').value || null;
      if (!Object.keys(body).length) { setMsg('No changes to save.', 'info'); return }
      setMsg('Saving…', 'info');
      var res = await window.wellspring.api('PATCH', '/api/events/' + x.id, body);
      if (!res.ok) { setMsg('Not saved: ' + (res.data.errors || [res.data.error]).join(' '), 'err'); return }
      selId = x.id; await load(); fillPick(); loadForm(x.id);
      setMsg('Saved changes to #' + x.id + '.', 'ok');
    });
    /* ALTERED (Version B layout): Show database is now a button (it was a checkbox), and there is a new Show filters button.
       fgShown / tblShown track whether the filter grid and the table are open. */
    var fgShown = false;
    $('showFil').addEventListener('click', function () { fgShown = !fgShown; syncBtns() });
    $('sort').value = 's:asc'; render(); syncBtns();
 
    /* ---- CHANGED (Assignment 7): roles come from real sign-in ----
       The module script at the bottom signs the user in, asks the server for their role, and calls applyRole().
       Any element with a data-role attribute is shown only to the roles listed in it (space-separated).
       Hiding elements is only for convenience: the SERVER decides which rows are returned and who may update. */
    var currentRole = '';
    // The server already returns only the requests this user may see (clients: their own; staff: all).
    function scoped() { return D; }
    // ADDED: for client users, trims an id -> name map (rooms, coordinators) down to the ids that appear on their own requests,
    // so their filter lists don't reveal other clients' rooms or staff. Coordinators get the full map.
    function visibleMap(map, k) {
      if (currentRole !== 'client') return map;
      var out = {};
      scoped().forEach(function (x) { if (x[k] != null && map[x[k]] != null) out[x[k]] = map[x[k]] });
      return out;
    }
    // role is "client" or "coordinator" (staff); label is shown in the banner.
    function applyRole(role, label) {
      currentRole = role;
      // Start each user with a clean view: clear the filters, rebuild the filter lists from only their rows, and redraw
      $('reset').click(); buildFilters(); render();
      $('app').hidden = !role;
      document.querySelectorAll('[data-role]').forEach(function (el) {
        el.hidden = !role || el.getAttribute('data-role').split(' ').indexOf(role) < 0;
      });
      if (role !== 'coordinator' && !$('edit').hidden) showEdit(false); // close the update panel if it was open
      $('roleBanner').textContent = role ? 'Signed in as ' + label + '.' : '';
      note('');
    }

  /* ---- CHANGED (Assignment 7): load data through the Express server ----
     GET /api/events returns each event with its related client, room and coordinator rows. */
function txt(v){return Array.isArray(v)?v.join(', '):(v==null?'':String(v))}
function iso(v){
  if(!v)return null;var d=new Date(v);if(isNaN(d))return null;
  var p=function(n){return(n<10?'0':'')+n};
  return d.getFullYear()+'-'+p(d.getMonth()+1)+'-'+p(d.getDate())+'T'+p(d.getHours())+':'+p(d.getMinutes());
}
async function load(){
  var api=window.wellspring.api, staff=currentRole==='coordinator';
  $('dbmsg').textContent='Loading data…';
  // archived=1 so the "Show archived" checkbox can work on the page
  var calls=[api('GET','/api/events?archived=1')];
  if(staff)calls.push(api('GET','/api/rooms'),api('GET','/api/coordinators')); // full lists for the update dropdowns
  var res=await Promise.all(calls);
  if(!res[0].ok){$('dbmsg').textContent='Could not load data: '+res[0].data.error;return}
  CL={};CO={};RM={};
  res[0].data.forEach(function(r){
    if(r.client)CL[r.c_id]=r.client.c_name;
    if(r.coordinator)CO[r.co_id]=r.coordinator.co_name;
    if(r.room)RM[r.r_id]=r.room.r_name;
  });
  if(staff&&res[1].ok)res[1].data.forEach(function(r){RM[r.r_id]=r.r_name+(r.r_status==='Available'?'':' ('+r.r_status+')')});
  if(staff&&res[2].ok)res[2].data.forEach(function(c){CO[c.co_id]=c.co_name});
  D=res[0].data.map(function(r){return{
    id:r.e_id,c:r.c_id,co:r.co_id,r:r.r_id==null?null:r.r_id,
    cat:r.e_category,type:r.e_type,name:r.e_name,
    s:iso(r.e_start)||'',e:iso(r.e_end)||'',att:r.e_attendance,
    fur:txt(r.e_furniture),tech:txt(r.e_tech),cater:txt(r.e_catering),notes:txt(r.e_notes),
    pri:r.e_priority,st:r.e_status,cr:iso(r.e_created_at),ar:iso(r.e_archived_at)
  }});
  optsMap($('fc'),'All clients',CL);
  optsMap($('f_c'),'',CL);optsMap($('f_co'),'',CO);optsMap($('f_r'),'No room assigned',RM);
  buildFilters();$('dbmsg').textContent=D.length?'':'No event requests yet.';render();
}
</script>

<!-- Sign-in check. Sends signed-out visitors to the sign-in page. -->
<script type="module" is:inline>
  import { requireSignIn, showStaffHeader, showAlert } from '/auth.js';
  const me = await requireSignIn();
  if (!me.isStaff && !me.client) location.href = '/login.html'; // new client: create profile first
  showStaffHeader(me);
  const label = me.email + (me.isStaff ? ' (staff)' : ' (client: ' + me.client.c_name + ')');
  applyRole(me.isStaff ? 'coordinator' : 'client', label);

  // Read the one-time success message left by eventForm
  let flash = null;
  try {
    flash = JSON.parse(sessionStorage.getItem('flash'));
    sessionStorage.removeItem('flash'); // show once only, so a refresh won't repeat it
  } catch (e) {}

  if (flash) {
    showAlert(document.getElementById('flash'), 'success', flash.text); // textContent: user-typed title is not treated as HTML
    if (flash.id) { openRows[flash.id] = true; selId = flash.id; } // open the new request's details row
  }

  await load();

  if (flash && flash.id) {
    const row = document.querySelector('tr.row[data-id="' + flash.id + '"], .ev-card[data-id="' + flash.id + '"]');
    if (row) row.scrollIntoView({ block: 'center' });
  }
</script>
